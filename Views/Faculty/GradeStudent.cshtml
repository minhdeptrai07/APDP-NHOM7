@model IEnumerable<SMS_APDP.Models.StudentCourse>

@{
    ViewData["Title"] = "Grade Student";
}

<div class="container mt-5">
    <h2 class="text-center mb-4">Grade Student</h2>
    <table class="table table-striped table-bordered">
        <thead class="thead-dark">
            <tr>
                <th>Student Name</th>
                <th>Course Name</th>
                <th>Grade</th>
                <th>Actions</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var item in Model)
            {
                <tr>
                    <td>@item.Student?.FullName</td>
                    <td>@item.Course?.CourseName</td>
                    <td>@item.Grade</td>
                    <td>
                        <a asp-action="EditGrade" asp-route-id="@item.Id" class="btn btn-warning btn-sm">Edit Grade</a>
                    </td>
                </tr>
            }
        </tbody>
    </table>
</div>
